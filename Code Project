class EnemyQueue {
public:
    QueueNode* front;
    QueueNode* rear;
    int        size;

    EnemyQueue() : front(nullptr), rear(nullptr), size(0) {}
    ~EnemyQueue() {
        QueueNode* cur = front;
        while (cur) { QueueNode* tmp = cur->next; delete cur; cur = tmp; }
    }

    void enqueue(Enemy e) {
        QueueNode* node = new QueueNode(e);
        if (!rear) { front = rear = node; }
        else { rear->next = node; rear = node; }
        size++;
    }

    bool dequeue(Enemy& e) {
        if (!front) return false;
        e = front->enemy;
        QueueNode* tmp = front; front = front->next;
        if (!front) rear = nullptr;
        delete tmp; size--; return true;
    }

    Enemy* peekFront() {
        if (!front) return nullptr;
        return &front->enemy;
    }

    bool isEmpty() const { return front == nullptr; }

    void display() const {
        if (!front) { cout << DIM << "  (tidak ada musuh)" << RESET << "\n"; return; }
        cout << RED << "  FRONT" << RESET;
        QueueNode* cur = front;
        while (cur) {
            cout << RED << " -> " << RESET;
            cout << "[" << cur->enemy.symbol << " " << cur->enemy.name
                 << " HP:" << cur->enemy.hp << "]";
            cur = cur->next;
        }
        cout << RED << " -> NULL" << RESET << "\n";
    }
};

