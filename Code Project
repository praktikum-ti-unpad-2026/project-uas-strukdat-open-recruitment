Enemy spawnEnemy(int floor, bool isBoss = false) {
    Enemy e;
    if (isBoss) {
        e.name = "Raja Penjara";
        e.symbol = 'K';
        e.hp = e.maxHp = 60;
        e.attack = 12; e.defense = 5; e.expReward = 100;
        return e;
    }
    int r = rand() % 3;
    if (floor == 1) {
        string names[] = {"Goblin", "Tikus Raksasa", "Penjaga Tulang"};
        char   syms[]  = {'G',      'T',              'P'};
        int    hps[]   = {12, 10, 15};
        int    atks[]  = {4,   3,  5};
        int    defs[]  = {1,   0,  2};
        int    exps[]  = {15, 10, 20};
        e.name=names[r]; e.symbol=syms[r]; e.hp=e.maxHp=hps[r];
        e.attack=atks[r]; e.defense=defs[r]; e.expReward=exps[r];
    } else if (floor == 2) {
        string names[] = {"Kerangka",  "Zombie",   "Prajurit Gelap"};
        char   syms[]  = {'K',          'Z',         'D'};
        int    hps[]   = {20, 18, 25};
        int    atks[]  = {6,   5,  8};
        int    defs[]  = {2,   1,  3};
        int    exps[]  = {25, 20, 35};
        e.name=names[r]; e.symbol=syms[r]; e.hp=e.maxHp=hps[r];
        e.attack=atks[r]; e.defense=defs[r]; e.expReward=exps[r];
    } else {
        string names[] = {"Ksatria Hitam","Penyihir Jahat","Iblis Api"};
        char   syms[]  = {'B',             'W',             'F'};
        int    hps[]   = {35, 28, 40};
        int    atks[]  = {10,  8, 12};
