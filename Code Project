struct Edge {
    int    toRoom;
    string direction; 
    bool   locked;
};

struct AdjNode {
    Edge     edge;
    AdjNode* next;
    AdjNode(Edge e) : edge(e), next(nullptr) {}
};

class DungeonGraph {
public:
    Room     rooms[MAX_ROOMS];
    AdjNode* adjList[MAX_ROOMS];
    int      roomCount;
    int      floorNumber;

    DungeonGraph() : roomCount(0), floorNumber(1) {
        for (int i = 0; i < MAX_ROOMS; i++) adjList[i] = nullptr;
    }
    ~DungeonGraph() { clearAdjList(); }

    void clearAdjList() {
        for (int i = 0; i < MAX_ROOMS; i++) {
            AdjNode* cur = adjList[i];
            while (cur) { AdjNode* tmp = cur->next; delete cur; cur = tmp; }
            adjList[i] = nullptr;
        }
        roomCount = 0;
    }

    void addRoom(Room r) {
        rooms[roomCount++] = r;
    }

    void addEdge(int from, int to, const string& dir, bool locked = false) {
        Edge e; e.toRoom = to; e.direction = dir; e.locked = locked;
        AdjNode* node = new AdjNode(e);
        node->next = adjList[from]; adjList[from] = node;
    }

    vector<Edge> getExits(int roomId) const {
        vector<Edge> exits;
        AdjNode* cur = adjList[roomId];
        while (cur) { exits.push_back(cur->edge); cur = cur->next; }
        return exits;
    }

    bool hasEdge(int from, const string& dir, int& toRoom, bool& locked) const {
        AdjNode* cur = adjList[from];
        while (cur) {
            if (cur->edge.direction == dir) {
                toRoom = cur->edge.toRoom;
                locked = cur->edge.locked;
                return true;
            }
            cur = cur->next;
        }
        return false;
    }

    void displayMap(int currentRoom) const {
        cout << BOLD << "  PETA LABIRIN (Lantai " << floorNumber << ")\n" << RESET;
        cout << DIM << "  " << string(30, '-') << RESET << "\n";

        int cols = 3;
        for (int i = 0; i < roomCount; i++) {
            if (i % cols == 0) cout << "  ";
            const Room& r = rooms[i];
            char sym;
            string color;
            if (i == currentRoom) {
                sym = '@'; color = BOLD + string(YELLOW);
            } else if (r.isExit) { 
                sym = 'E'; color = GREEN;
            } else if (!r.visited) {
                sym = '?'; color = DIM;
            } else if (r.hasEnemy) {
                sym = '!'; color = RED;
            } else {
                sym = '.'; color = CYAN;
            }
            cout << color << "[" << sym << "]" << RESET;
            if (i % cols == cols-1) cout << "\n";
            else cout << "-";
        }
        if (roomCount % cols != 0) cout << "\n";

        cout << DIM << "  ";
        cout << YELLOW << "[@]" << RESET << DIM << "Kamu  ";
        cout << GREEN  << "[E]" << RESET << DIM << "Exit  ";
        cout << RED    << "[!]" << RESET << DIM << "Bahaya  ";
        cout << DIM    << "[?]" << RESET << DIM << "Belum dijelajahi\n";
        cout << DIM << "  " << string(30, '-') << RESET << "\n";
    }

    void buildFloor(int floor);
};

