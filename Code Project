class SkillTree {
public:
    SkillNode* root;

    SkillTree() : root(nullptr) { buildTree(); }
    ~SkillTree() { destroyTree(root); }

    void destroyTree(SkillNode* node) {
        if (!node) return;
        destroyTree(node->left);
        destroyTree(node->right);
        delete node;
    }

    void buildTree() {
        Skill combatArts = {"Seni Bertarung", "Akar semua skill tempur", 0, 0, 0, 0, true};
        root = new SkillNode(combatArts);

        Skill sword   = {"Pedang Tajam",   "ATK +3",         3, 0, 0, 1, false};
        Skill shield  = {"Tameng Kuat",    "DEF +3",         0, 3, 0, 1, false};
        root->left  = new SkillNode(sword);
        root->right = new SkillNode(shield);

        Skill slash  = {"Serangan Kilat",  "ATK +5",         5, 0, 0, 2, false};
        Skill crit   = {"Serangan Kritis", "ATK +4, DEF +1", 4, 1, 0, 2, false};
        root->left->left  = new SkillNode(slash);
        root->left->right = new SkillNode(crit);

        Skill ironDef = {"Pertahanan Baja","DEF +5",          0, 5, 0, 2, false};
        Skill vitality= {"Vitalitas",      "MaxHP +10",       0, 0, 10,2, false};
        root->right->left  = new SkillNode(ironDef);
        root->right->right = new SkillNode(vitality);
    }

    void display(SkillNode* node, int depth, const string& prefix) const {
        if (!node) return;
        string indent = "";
        for (int i = 0; i < depth; i++) indent += "    ";
        if (node->skill.unlocked)
            cout << GREEN << indent << prefix << "[✓ " << node->skill.name << "]" << RESET;
        else
            cout << DIM   << indent << prefix << "[ " << node->skill.name << " | "
                 << node->skill.description << " | Cost:" << node->skill.cost << " SP]" << RESET;
        cout << "\n";
        if (node->left || node->right) {
            display(node->left,  depth+1, "L: ");
            display(node->right, depth+1, "R: ");
        }
    }

    void displayTree() const {
        cout << BOLD << YELLOW << "  SKILL TREE (Binary Tree)\n" << RESET;
        display(root, 0, "");
    }

    SkillNode* findSkill(SkillNode* node, const string& name) {
        if (!node) return nullptr;
        if (node->skill.name == name) return node;
        SkillNode* found = findSkill(node->left, name);
        if (found) return found;
        return findSkill(node->right, name);
    }

    bool unlockSkill(const string& name, int& sp, int& atkB, int& defB, int& hpB) {
        SkillNode* node = findSkill(root, name);
        if (!node) return false;
        if (node->skill.unlocked) { cout << YELLOW << "Skill sudah di-unlock!\n" << RESET; return false; }
        if (sp < node->skill.cost) {
            cout << RED << "Skill point tidak cukup! Dibutuhkan: " << node->skill.cost << "\n" << RESET;
            return false;
        }
        node->skill.unlocked = true;
        sp   -= node->skill.cost;
        atkB += node->skill.attackBonus;
        defB += node->skill.defenseBonus;
        hpB  += node->skill.hpBonus;
        return true;
    }
};

