void setupFloorEnemies(DungeonGraph& dg, EnemyQueue enemyQueues[], int floor) {
    for (int i = 0; i < dg.roomCount; i++) {
        Enemy dummy;
        while (!enemyQueues[i].isEmpty()) enemyQueues[i].dequeue(dummy);

        if (dg.rooms[i].hasEnemy) {
            bool isBoss = (floor == 3 && i == 4); 
            int enemyCount = isBoss ? 1 : (floor == 1 ? 1 : (rand()%2 + 1));
            for (int j = 0; j < enemyCount; j++) {
                enemyQueues[i].enqueue(spawnEnemy(floor, isBoss));
            }
        }
    }
}

string toLower(string s) {
    for (char& c : s) c = tolower(c);
    return s;
}

bool playFloor(Player& p, DungeonGraph& dg, SkillTree& st, int floor) {
    dg.buildFloor(floor);
    p.currentFloor = floor;
    p.currentRoom  = 0;

    EnemyQueue enemyQueues[MAX_ROOMS];
    setupFloorEnemies(dg, enemyQueues, floor);

    dg.rooms[0].visited = true;
    bool floorDone = false;

    while (!floorDone) {
        Room& curRoom = dg.rooms[p.currentRoom];

        if (curRoom.hasTrap && !curRoom.visited) {
            clearScreen();
            showHUD(p, dg);
            cout << RED << BOLD << "\n  ⚠  JEBAKAN TERPICU!\n" << RESET;
            cout << RED << "  Kamu menginjak jebakan dan kehilangan " << curRoom.trapDamage << " HP!\n" << RESET;
            p.hp -= curRoom.trapDamage;
            p.score = max(0, p.score - 20);
            pressEnter();
            if (p.hp <= 0) return false; 
        }

        if (!enemyQueues[p.currentRoom].isEmpty() && curRoom.hasEnemy) {
            clearScreen();
            showHUD(p, dg);
            cout << RED << "\n  ☠  Musuh menyerang!\n" << RESET;
            pressEnter();

            bool survived = runCombat(p, enemyQueues[p.currentRoom]);
            if (!survived) {
                if (p.hp <= 0) return false; 
                int prevRoom, prevFloor;
                if (p.moveHistory.pop(prevRoom, prevFloor)) {
                    cout << YELLOW << "\n  Kamu kabur kembali ke ruangan sebelumnya!\n" << RESET;
                    p.currentRoom = prevRoom;
                    pressEnter();
                    continue;
                }
            }
            if (enemyQueues[p.currentRoom].isEmpty())
                curRoom.hasEnemy = false;
        }

        curRoom.visited = true;

        clearScreen();
        showHUD(p, dg);
        dg.displayMap(p.currentRoom);
        vector<Edge> exits = dg.getExits(p.currentRoom);
        showRoom(curRoom, exits);

        cout << "\n  > ";
        string cmd; getline(cin, cmd);
        cmd = toLower(cmd);

       bool isMove = false;
        
        string targetDir = "";
        if (cmd == "w") targetDir = "atas";
        else if (cmd == "s") targetDir = "bawah";
        else if (cmd == "d") targetDir = "kanan";
        else if (cmd == "a") targetDir = "kiri";

        if (targetDir != "") {
            int toRoom; bool locked;
            if (dg.hasEdge(p.currentRoom, targetDir, toRoom, locked)) {
                if (locked && !p.hasKey) {
                    cout << RED << "\n  Pintu ini terkunci! Kamu butuh kunci.\n" << RESET;
                    pressEnter();
                } else {
                    if (locked && p.hasKey) {
                        cout << YELLOW << "\n  Kamu menggunakan kunci untuk membuka pintu.\n" << RESET;
                        p.hasKey = false;
                        pressEnter();
                    }
                    p.moveHistory.push(p.currentRoom, floor);
                    p.currentRoom = toRoom;
                    p.steps++;
                    p.score += 5;
                }
            } else {
                cout << RED << "\n  Tidak ada jalan ke arah tersebut!\n" << RESET;
                pressEnter();
            }
            continue;
        }

        if (cmd == "undo") {
            int prevRoom, prevFloor;
            if (p.moveHistory.pop(prevRoom, prevFloor)) {
                p.currentRoom = prevRoom;
                p.steps++;
                p.score = max(0, p.score - 3);
                cout << MAGENTA << "\n  Undo! Kembali ke ruangan sebelumnya.\n" << RESET;
                pressEnter();
            } else {
                cout << YELLOW << "\n  Tidak ada riwayat langkah untuk di-undo!\n" << RESET;
                pressEnter();
            }
        } else if (cmd == "ambil") {
            if (curRoom.hasItem && !curRoom.roomItem.name.empty()) {
                Item it = curRoom.roomItem;
                if (it.type == "key") {
                    p.hasKey = true;
                    cout << YELLOW << "\n  Kamu mengambil " << it.name << "!\n" << RESET;
                } else {
                    p.inventory.addItem(it);
                    cout << GREEN << "\n  " << it.name << " ditambahkan ke inventory!\n" << RESET;
                }
                curRoom.hasItem = false;
                curRoom.roomItem.name = "";
                p.score += 15;
                pressEnter();
            } else {
                cout << YELLOW << "\n  Tidak ada item di ruangan ini.\n" << RESET;
                pressEnter();
            }

        } else if (cmd == "inventory" || cmd == "inv") {
            manageInventory(p);
        } else if (cmd == "skill" || cmd == "skills") {
            manageSkillTree(p, st);
        } else if (cmd == "status") {
            showStatus(p);
        } else if (cmd == "peta" || cmd == "map") {
            clearScreen();
            showHUD(p, dg);
            dg.displayMap(p.currentRoom);
            cout << "\n  Ruangan yang sudah dikunjungi:\n";
            for (int i = 0; i < dg.roomCount; i++) {
                if (dg.rooms[i].visited) {
                    cout << "  " << DIM << "[" << i << "] " << RESET << dg.rooms[i].name;
                    if (i == p.currentRoom) cout << YELLOW << "  ← KAMU DI SINI" << RESET;
                    cout << "\n";
                }
            }
            cout << "\n  Riwayat langkah (Stack):\n";
            p.moveHistory.display();
            pressEnter();
        } else if (cmd == "bantuan" || cmd == "help") {
            showHelp();
        } else if (cmd == "keluar" || cmd == "exit") {
            cout << YELLOW << "\n  Kembali ke menu utama? (y/n): " << RESET;
            string confirm; getline(cin, confirm);
            if (confirm == "y") return false;
        } else {
            cout << DIM << "\n  Perintah tidak dikenal. Ketik 'bantuan' untuk daftar perintah.\n" << RESET;
            pressEnter();
        }

        if (dg.rooms[p.currentRoom].isExit) {
            clearScreen();
            showHUD(p, dg);
            if (floor < MAX_FLOORS) {
                cout << GREEN << BOLD << "\n  ✦ Kamu menemukan tangga menuju lantai berikutnya!\n" << RESET;
                cout << "\n  Lanjutkan ke Lantai " << floor+1 << "? (y/n): ";
                string c; getline(cin, c);
                if (toLower(c) == "y") {
                    p.score += 100;
                    floorDone = true;
                }
            } else {
                floorDone = true;
                return true; 
            }
        }

        if (p.hp <= 0) return false;
    }
    return true; 
}

void gameLoop() {
    srand((unsigned)time(nullptr));

    Player p;
    clearScreen();
    printBox("DUNGEON ESCAPE — NEW GAME", GREEN);
    cout << "\n  Masukkan nama karaktermu: ";
    getline(cin, p.name);
    if (p.name.empty()) p.name = "Petualang";

    cout << GREEN << "\n  Selamat datang, " << p.name << "!\n" << RESET;
    cout << DIM << "  Temukan jalan keluar dari 3 lantai penjara bawah tanah ini.\n" << RESET;
    pressEnter();

    DungeonGraph dg;
    SkillTree    st;
    bool         won = false;

    for (int floor = 1; floor <= MAX_FLOORS; floor++) {
        clearScreen();
        printBox("LANTAI " + to_string(floor) + " dari 3", YELLOW);
        pressEnter();

        bool result = playFloor(p, dg, st, floor);

        if (p.hp <= 0) {
            while (true) {
                showGameOver(p);
                string c; getline(cin, c);
                c = toLower(c);
                if (c == "r") { gameLoop(); return; }
                if (c == "q") return;
            }
        }

        if (!result) return; 

        if (floor == MAX_FLOORS) { won = true; break; }
    }

    if (won) {
        while (true) {
            showVictory(p);
            string c; getline(cin, c);
            c = toLower(c);
            if (c == "r") { gameLoop(); return; }
            if (c == "q") return;
        }
    }
}

int main() {
    system("chcp 65001");
    enableANSI();
    srand((unsigned)time(nullptr));

    while (true) {
        showMainMenu();
        string choice; getline(cin, choice);

        if (choice == "1") {
            gameLoop();
        } else if (choice == "2") {
            showHowToPlay();
        } else if (choice == "3") {
            showAboutDS();
        } else if (choice == "4") {
            clearScreen();
            cout << DIM << "\n  Sampai jumpa di penjara bawah tanah berikutnya...\n\n" << RESET;
            break;
        } else {
            cout << RED << "\n  Pilihan tidak valid!\n" << RESET;
        }
    }
    return 0;
}
