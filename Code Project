                       bool hasIt, bool visited, bool exit, Item item, int trapDmg, char sym) -> Room {
        Room r; r.id=id; r.name=name; r.description=desc;
        r.hasEnemy=enemy; r.hasTrap=trap; r.hasItem=hasIt;
