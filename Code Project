        e.attack=atks[r]; e.defense=defs[r]; e.expReward=exps[r];
    }
    return e;
}

void checkLevelUp(Player& p) {
    while (p.exp >= p.expToLevel) {
        p.exp      -= p.expToLevel;
        p.level++;
        p.expToLevel = p.level * 50;
        p.attack   += 2;
        p.defense  += 1;
        p.maxHp    += 5;
        p.hp        = min(p.hp + 5, p.maxHp);
        p.skillPoints++;
        showLevelUp(p);
    }
}

bool runCombat(Player& p, EnemyQueue& eq) {
    if (eq.isEmpty()) return true;

    while (!eq.isEmpty()) {
        Enemy* ep = eq.peekFront();
        if (!ep) break;
        Enemy enemy = *ep;

        bool combatDone = false;
        while (!combatDone) {
            clearScreen();
            showHUD(p, *(DungeonGraph*)nullptr); 
            showCombatScreen(p, enemy, eq);

            string action;
            getline(cin, action);
            for (char& c : action) c = tolower(c);

            if (action == "a" || action == "serang") {
                int dmg = max(1, p.attack - enemy.defense + (rand() % 3));
                enemy.hp -= dmg;
                cout << GREEN << "\n  Kamu menyerang " << enemy.name
                     << " dan memberikan " << dmg << " damage!" << RESET << "\n";

                if (enemy.hp <= 0) {
                    cout << YELLOW << "\n  ★ " << enemy.name << " dikalahkan! +" << enemy.expReward << " EXP\n" << RESET;
                    p.exp   += enemy.expReward;
                    p.score += enemy.expReward * 10;
                    checkLevelUp(p);
                    Enemy dummy; eq.dequeue(dummy);
                    combatDone = true;
                    pressEnter();
                } else {
                    int eDmg = max(1, enemy.attack - p.defense + (rand() % 3));
                    p.hp -= eDmg;
                    cout << RED << "  " << enemy.name << " membalas dengan " << eDmg << " damage!\n" << RESET;
                    if (eq.front) eq.front->enemy.hp = enemy.hp;
                    pressEnter();
                }

            } else if (action == "t" || action == "tangkis") {
                int eDmg = max(0, enemy.attack - p.defense - 2 + (rand() % 2));
                p.hp -= eDmg;
                cout << CYAN << "\n  Kamu menangkis! Damage dikurangi. Menerima " << eDmg << " damage.\n" << RESET;
                pressEnter();

            } else if (action == "i" || action == "gunakan item") {
                cout << "\n";
                p.inventory.display();
                cout << "\n  Nama item yang ingin digunakan: ";
                string itemName; getline(cin, itemName);
                Item* it = p.inventory.findItem(itemName);
                if (!it) {
                    cout << RED << "  Item tidak ditemukan!\n" << RESET; pressEnter();
                } else if (it->type == "heal") {
                    int heal = it->value;
                    p.hp = min(p.hp + heal, p.maxHp);
                    cout << GREEN << "  +" << heal << " HP dipulihkan!\n" << RESET;
                    p.inventory.removeItem(itemName);
                    pressEnter();
                } else {
                    cout << YELLOW << "  Item ini tidak bisa digunakan dalam pertarungan.\n" << RESET;
                    pressEnter();
                }

            } else if (action == "l" || action == "lari") {
                int chance = rand() % 100;
                if (chance < 40) {
                    cout << YELLOW << "\n  Kamu berhasil kabur!\n" << RESET;
                    pressEnter();
                    return false; 
                } else {
                    int eDmg = max(1, enemy.attack - p.defense);
                    p.hp -= eDmg;
                    cout << RED << "\n  Gagal kabur! Musuh menyerang dan memberikan " << eDmg << " damage!\n" << RESET;
                    pressEnter();
                }
            } else {
                cout << RED << "  Perintah tidak valid! Gunakan: a/serang, t/tangkis, i/gunakan item, l/lari\n" << RESET;
                pressEnter();
            }

            if (p.hp <= 0) return false; 
        }

        if (p.hp <= 0) return false;
    }
    return true; 
}

