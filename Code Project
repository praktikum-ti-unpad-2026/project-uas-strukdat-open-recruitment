};

struct InventoryNode {
    Item          item;
    InventoryNode* next;
    InventoryNode(Item i) : item(i), next(nullptr) {}
};

class Inventory {
public:
    InventoryNode* head;
    int            size;

    Inventory() : head(nullptr), size(0) {}
    ~Inventory() {
        InventoryNode* cur = head;
        while (cur) { InventoryNode* tmp = cur->next; delete cur; cur = tmp; }
    }

    void addItem(Item i) {
        InventoryNode* node = new InventoryNode(i);
        if (!head) { head = node; }
        else {
            InventoryNode* cur = head;
            while (cur->next) cur = cur->next;
            cur->next = node;
        }
        size++;
    }

    bool removeItem(const string& name) {
        if (!head) return false;
        if (head->item.name == name) {
            InventoryNode* tmp = head; head = head->next; delete tmp; size--; return true;
        }
        InventoryNode* cur = head;
        while (cur->next && cur->next->item.name != name) cur = cur->next;
        if (!cur->next) return false;
        InventoryNode* tmp = cur->next; cur->next = tmp->next; delete tmp; size--; return true;
    }

    Item* findItem(const string& name) {
        InventoryNode* cur = head;
        while (cur) { if (cur->item.name == name) return &cur->item; cur = cur->next; }
        return nullptr;
    }

    void display() const {
        if (!head) { cout << DIM << "  (kosong)" << RESET << "\n"; return; }
        cout << YELLOW << "  HEAD" << RESET;
        InventoryNode* cur = head;
        while (cur) {
            cout << YELLOW << " -> " << RESET;
            cout << "[" << CYAN << cur->item.name << RESET;
            if (cur->item.type == "heal")   cout << " +" << cur->item.value << "HP";
            if (cur->item.type == "weapon") cout << " ATK+" << cur->item.value;
            cout << "]";
            cur = cur->next;
        }
        cout << YELLOW << " -> NULL" << RESET << "\n";
        cout << DIM << "  Total item: " << size << RESET << "\n";
    }

    bool isEmpty() const { return head == nullptr; }
};

struct StackNode {
    int        roomId;
    int        floor;
    StackNode* next;
    StackNode(int r, int f) : roomId(r), floor(f), next(nullptr) {}
};

class MoveStack {
public:
    StackNode* top;
    int        size;

    MoveStack() : top(nullptr), size(0) {}
    ~MoveStack() {
        StackNode* cur = top;
        while (cur) { StackNode* tmp = cur->next; delete cur; cur = tmp; }
    }

    void push(int roomId, int floor) {
        StackNode* node = new StackNode(roomId, floor);
        node->next = top; top = node; size++;
    }

    bool pop(int& roomId, int& floor) {
        if (!top) return false;
        roomId = top->roomId; floor = top->floor;
        StackNode* tmp = top; top = top->next; delete tmp; size--; return true;
    }

    bool peek(int& roomId, int& floor) const {
        if (!top) return false;
        roomId = top->roomId; floor = top->floor; return true;
    }

    bool isEmpty() const { return top == nullptr; }

    void display() const {
        if (!top) { cout << DIM << "  (riwayat kosong)" << RESET << "\n"; return; }
        cout << MAGENTA << "  TOP" << RESET;
        StackNode* cur = top;
        int count = 0;
        while (cur && count < 5) {
            cout << MAGENTA << " -> " << RESET << "[Lantai " << cur->floor << " R" << cur->roomId << "]";
            cur = cur->next; count++;
        }
        if (cur) cout << " ...";
        cout << MAGENTA << " -> NULL" << RESET << "\n";
    }
};

